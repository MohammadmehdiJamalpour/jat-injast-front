NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3004

# Optional Map.ir sandbox/development configuration.
MAPIR_API_KEY=
MAPIR_BASE_URL=https://map.ir
NEXT_PUBLIC_MAPIR_BASE_URL=https://map.ir
NEXT_PUBLIC_MAPIR_TILE_URL=

# Optional vendor-neutral web vitals collection.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
NEXT_PUBLIC_WEB_VITALS_DEBUG=false

# Server-read auth cookie name for dashboard route gating. The backend should
# set this as an HttpOnly, Secure, SameSite cookie after auth migration.
AUTH_COOKIE_NAME=__Host-jat_auth

# Optional legacy media rewrites for older imported assets.
NEXT_PUBLIC_API_STORAGE_PREFIX=
NEXT_PUBLIC_CDN_URL=
