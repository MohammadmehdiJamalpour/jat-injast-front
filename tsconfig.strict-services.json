{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/services/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts"
  ]
}
